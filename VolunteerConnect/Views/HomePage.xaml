<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VolunteerConnect.Views.HomePage"
    Title="Home">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="25">

            <!-- Application Name -->
            <Label
                Text="Volunteer Connect"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <!-- Short Explanation -->
            <Label
                Text="Find meaningful volunteer opportunities and make an impact in your community."
                FontSize="18"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <!-- Featured Opportunity -->
            <Border
                Stroke="LightGray"
                StrokeThickness="1"
                Background="Transparent"
                Padding="15"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Featured Opportunity"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <Label
                        x:Name="FeaturedOpportunityTitle"
                        Text="Loading..."
                        FontSize="18" />

                    <Label
                        x:Name="FeaturedOpportunityDescription"
                        Text="Loading..."
                        FontSize="14" />

                    <Button
                        Text="View Details"
                        x:Name="FeaturedOpportunityButton" />
                </VerticalStackLayout>
            </Border>

            <!-- Number of Available Opportunities -->
            <Border
                Stroke="LightGray"
                StrokeThickness="1"
                Background="Transparent"
                Padding="15"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Available Opportunities"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <Label
                        x:Name="OpportunityCountLabel"
                        Text="Loading..."
                        FontSize="18" />
                </VerticalStackLayout>
            </Border>

            <!-- Navigation Buttons -->
            <VerticalStackLayout Spacing="15">
                <Button
                    Text="Browse Opportunities"
                    x:Name="BrowseOpportunitiesButton"
                    
                    BackgroundColor="#0078D4"
                    TextColor="White" />

                <Button
                    Text="My Registrations"
                    x:Name="MyRegistrationsButton"
                    BackgroundColor="#0078D4"
                    TextColor="Green" />


            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
