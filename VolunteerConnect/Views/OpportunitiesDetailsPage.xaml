<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VolunteerConnect.Views.OpportunitiesDetailsPage"
    Title="Opportunity Details">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Title -->
            <Label
                x:Name="TitleLabel"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <!-- Category -->
            <Label
                x:Name="CategoryLabel"
                FontSize="18"
                TextColor="Gray"
                HorizontalOptions="Center" />

            <!-- Image -->
            <Image
                x:Name="ImageControl"
                HeightRequest="180"
                Aspect="AspectFill"
                Margin="0,10" />

            <!-- Date -->
            <Label
                x:Name="DateLabel"
                FontSize="16"
                TextColor="Gray" />

            <!-- Time -->
            <Label
                x:Name="TimeLabel"
                FontSize="16"
                TextColor="Gray" />

            <!-- Location -->
            <Label
                x:Name="LocationLabel"
                FontSize="16"
                TextColor="Gray" />

            <!-- Full Description -->
            <Label
                Text="Description"
                FontSize="20"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <Label
                x:Name="FullDescriptionLabel"
                FontSize="16"
                LineBreakMode="WordWrap" />

            <!-- Requirements -->
            <Label
                Text="Volunteer Requirements"
                FontSize="20"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <Label
                x:Name="RequirementsLabel"
                FontSize="16"
                LineBreakMode="WordWrap" />

            <!-- Available Places -->
            <Label
                x:Name="AvailablePlacesLabel"
                FontSize="16"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <!-- Register Interest Button -->
            <Button
                Text="Register Interest"
                x:Name="RegisterButton"
                BackgroundColor="#0078D4"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
