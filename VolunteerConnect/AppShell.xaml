<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VolunteerConnect.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:VolunteerConnect.Views">

    <!-- Main navigation structure -->
    <TabBar>

        <!-- Home -->
        <ShellContent
            Title="Home"
            Icon="home.png"
            ContentTemplate="{DataTemplate views:HomePage}" />

        <!-- Opportunities -->
        <ShellContent
            Title="Opportunities"
            Icon="opportunities.png"
            ContentTemplate="{DataTemplate views:OpportunitiesPage}" />

        <!-- My Registrations -->
        <ShellContent
            Title="My Registrations"
            Icon="registrations.png"
            ContentTemplate="{DataTemplate views:MyRegistrationsPage}" />

        <!-- Privacy -->
        
        <ShellContent
            IsVisible="False"
            Title="Privacy"
            Icon="privacy.png"
            ContentTemplate="{DataTemplate views:PrivacyInformationPage}" />
    
        
        <!-- Registration Page -->
        <ShellContent 
            Title="Registration"
            ContentTemplate="{DataTemplate views:RegistrationPage}" />


    </TabBar>

</Shell>
